# Core
DATABASE_URL=postgresql://notes:notes@localhost:5432/notes?schema=public
REDIS_URL=redis://localhost:6379
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
MEDIA_ROOT=./.data/media

# Required. Generate with: openssl rand -base64 48
# The server refuses to start in production without a value of 32+ characters.
SESSION_SECRET=replace-this-with-a-long-random-value

# Bootstrap admin, created only when the database has no users. Minimum 12 characters.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me-before-first-boot

# Local dev is plain HTTP, so the Secure cookie flag has to be relaxed.
# Never set this to false for a deployment reachable over the network.
SECURE_COOKIES=false

# Set to false only when the API is exposed directly, with no reverse proxy or ingress.
TRUST_PROXY=true

# Publishes Swagger UI at /docs and the spec at /api/v1/openapi.json. Unauthenticated - keep off in production.
ENABLE_API_DOCS=true

# Rate limits (requests per window, per client IP)
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=10
LLM_RATE_LIMIT_MAX=30
BODY_LIMIT_BYTES=2097152
SHUTDOWN_TIMEOUT_MS=15000

# OIDC Configuration
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_REDIRECT_URI=http://localhost:5173/api/v1/auth/oidc/callback
OIDC_ADMIN_EMAILS=

# OpenAI / LLM Configuration
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_CHAT_MODEL=gpt-4o-mini
LLM_EMBEDDINGS_MODEL=
LLM_TIMEOUT_MS=30000
LLM_MAX_TOKENS=2048
# Comma-separated hostnames allowed as an LLM base URL. Leave empty to allow any public HTTPS host.
# Required to point at a private or self-hosted model server, e.g. ollama.internal,vllm.svc.cluster.local
LLM_ALLOWED_HOSTS=