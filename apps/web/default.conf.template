# Rendered by the nginx entrypoint from /etc/nginx/templates at container start, so the API origin
# is deployment-specific rather than baked into the image.
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # The SPA is same-origin with the API it proxies to, so it may talk to itself and nothing else.
  # Security headers live in an included snippet because nginx drops inherited add_header
  # directives in any location that declares an add_header of its own.

  location = /healthz {
    access_log off;
    return 200 "ok\n";
  }

  location /api/ {
    include /etc/nginx/security-headers.conf;
    proxy_pass ${API_ORIGIN};
    # Matches the 10 MB cap the media endpoint enforces; the 1 MB default rejected uploads with an HTML error page.
    client_max_body_size 10m;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 300s;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location = /index.html {
    include /etc/nginx/security-headers.conf;
    add_header Cache-Control "no-cache" always;
  }

  location = /sw.js {
    include /etc/nginx/security-headers.conf;
    add_header Cache-Control "no-cache" always;
  }

  location /assets/ {
    include /etc/nginx/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
  }

  location / {
    include /etc/nginx/security-headers.conf;
    try_files $uri $uri/ /index.html;
  }
}
